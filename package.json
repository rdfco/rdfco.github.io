{
  "name": "gspa-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/validate/verify-brand-safety.mjs",
    "preview": "vite preview",
    "check": "npm run build",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run content:validate && npm run theme:validate && npm run assets:validate && npm run audit:runtime && npm run build && npm run public:bundles && npm run check:bundle",
    "typecheck": "tsc --noEmit",
    "audit:runtime": "node scripts/validate/audit-runtime.mjs",
    "public:bundles": "node scripts/validate/verify-public-bundles.mjs",
    "check:bundle": "node scripts/validate/check-bundle-budget.mjs",
    "assets:validate": "node scripts/validate/validate-asset-registry.mjs",
    "content:validate": "node scripts/validate/validate-content-boundaries.mjs",
    "theme:validate": "node scripts/validate/validate-theme-tokens.mjs",
    "browser:contract": "node scripts/browser/verify-navigation.mjs && node scripts/browser/browser-check.mjs",
    "browser:menu-performance": "node scripts/browser/verify-menu-performance.mjs",
    "browser:home-lifecycle": "node scripts/browser/verify-home-lifecycle.mjs",
    "browser:responsive-interactions": "node scripts/browser/verify-responsive-interactions.mjs",
    "browser:network": "node scripts/browser/verify-network.mjs",
    "visual:baseline": "node scripts/visual/capture-baseline.mjs",
    "visual:compare": "node scripts/visual/compare-baseline.mjs",
    "visual:contract": "npm run build && node scripts/visual/capture-contract.mjs",
    "baseline:performance": "node scripts/visual/capture-performance-baseline.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.5",
    "puppeteer-core": "^25.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
